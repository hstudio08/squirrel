rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorizedUser() {
      return request.auth != null && 
             request.auth.token.email_verified == true && (
               request.auth.token.email == "officialhaadi81@gmail.com" || 
               request.auth.token.email == "sadiyaayoub22019@gmail.com"
             );
    }

    match /conversations/{conversationId} {
      allow read: if isAuthorizedUser();
      allow create: if isAuthorizedUser();
      allow update: if isAuthorizedUser() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinnedMessage'])
                    && (!('pinnedMessage' in request.resource.data) || (request.resource.data.pinnedMessage is string && request.resource.data.pinnedMessage.size() <= 2000));
      
      match /messages/{messageId} {
        allow get: if isAuthorizedUser();
        allow list: if isAuthorizedUser() && (
          request.auth.token.email == "officialhaadi81@gmail.com" ||
          request.query.limit <= 300
        );
        
        allow create: if isAuthorizedUser()
                      && request.resource.data.keys().hasAll(['text', 'senderId', 'createdAt', 'seen'])
                      && request.resource.data.keys().hasOnly([
                           'text', 'senderId', 'createdAt', 'seen',
                           'imageUrl',
                           'replyToId', 'replyToText', 'replyToSenderId'
                         ])
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.seen == false
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 2000
                      && (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl is string)
                      && (!('replyToId' in request.resource.data) || (
                           request.resource.data.replyToId is string
                           && request.resource.data.replyToText is string
                           && request.resource.data.replyToSenderId is string
                         ));
                      
        allow update: if isAuthorizedUser() && (
          // Case 1: Recipient marks as seen
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'seenAt'])
            && request.resource.data.seen == true
            && request.resource.data.seenAt == request.time
            && resource.data.senderId != request.auth.uid
          ) ||
          // Case 2: Sender edits text (within 10 minutes)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'editedAt'])
            && resource.data.senderId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
            && request.resource.data.isEdited == true
            && request.resource.data.editedAt == request.time
            && request.time.toMillis() <= resource.data.createdAt.toMillis() + (10 * 60 * 1000)
          ) ||
          // Case 3: Any user pins/unpins
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned'])
          ) ||
          // Case 4: Any user deletes for themselves
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
            && request.resource.data.deletedFor is list
            && (
                 (!('deletedFor' in resource.data) && request.resource.data.deletedFor == [request.auth.uid])
                 ||
                 ('deletedFor' in resource.data && 
                  request.resource.data.deletedFor.hasAll(resource.data.deletedFor) && 
                  request.resource.data.deletedFor.size() == resource.data.deletedFor.size() + 1 && 
                  request.resource.data.deletedFor[resource.data.deletedFor.size()] == request.auth.uid)
               )
          ) ||
          // Case 5: Sender soft-deletes for everyone
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeletedForEveryone', 'text', 'imageUrl', 'replyToId', 'replyToText', 'replyToSenderId'])
            && resource.data.senderId == request.auth.uid
            && request.resource.data.isDeletedForEveryone == true
            && request.resource.data.text == ""
            && (!('imageUrl' in request.resource.data))
            && (!('replyToId' in request.resource.data))
          ) ||
          // Case 6: User adds or removes their own reaction (any emoji allowed)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.reactions is map
            && (
                 ! (request.auth.uid in request.resource.data.reactions) 
                 || (request.resource.data.reactions[request.auth.uid] is string && request.resource.data.reactions[request.auth.uid].size() <= 10)
               )
            && (
                 (!('reactions' in resource.data) && request.resource.data.reactions.keys().hasOnly([request.auth.uid]))
                 ||
                 ('reactions' in resource.data && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid]))
               )
          )
        );
        
        // Sender is allowed to delete their own messages for everyone (hard delete)
        allow delete: if isAuthorizedUser() && resource.data.senderId == request.auth.uid;
      }
    }
    
    match /users/{userId} {
      allow read: if isAuthorizedUser();
      allow write: if isAuthorizedUser() && request.auth.uid == userId
                   && request.resource.data.keys().hasOnly(['email', 'displayName', 'photoURL', 'lastSeen', 'lastLogin', 'uid', 'fcmTokens', 'fcmToken'])
                   && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100))
                   && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500));
    }
  }
}

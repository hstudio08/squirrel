rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorizedUser() {
      return request.auth != null && 
             request.auth.token.email_verified == true && (
               request.auth.token.email == "officialhaadi81@gmail.com" || 
               // request.auth.token.email == "sadiyaayoub22019@gmail.com"
               request.auth.token.email == "lonehaadi81@gmail.com"
             );
    }

    match /conversations/{conversationId} {
      allow read: if isAuthorizedUser();
      allow create: if isAuthorizedUser();
      allow update: if isAuthorizedUser() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinnedMessage'])
                    && (!('pinnedMessage' in request.resource.data) || (
                         request.resource.data.pinnedMessage is map &&
                         request.resource.data.pinnedMessage.keys().hasOnly(['id', 'text', 'senderId']) &&
                         request.resource.data.pinnedMessage.id is string && request.resource.data.pinnedMessage.id.size() <= 40 &&
                         request.resource.data.pinnedMessage.text is string && request.resource.data.pinnedMessage.text.size() <= 2000 &&
                         request.resource.data.pinnedMessage.senderId is string && request.resource.data.pinnedMessage.senderId.size() <= 128
                       ));
      
      match /messages/{messageId} {
        allow get: if isAuthorizedUser();
        allow list: if isAuthorizedUser() && (
          request.query.limit is int && request.query.limit <= 100
        );
        
        allow create: if isAuthorizedUser()
                      && request.resource.data.keys().hasAll(['senderId', 'createdAt', 'seen'])
                      && request.resource.data.keys().hasOnly([
                           'text', 'senderId', 'createdAt', 'seen', 'delivered', 'deliveredAt',
                           'imageUrl', 'imageUrls', 'audioUrl',
                           'replyToId', 'replyToText', 'replyToSenderId',
                           'isDeletedForEveryone', 'isEdited'
                         ])
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.seen == false
                      && (!('text' in request.resource.data) || request.resource.data.text is string)
                      && (!('text' in request.resource.data) || request.resource.data.text.size() <= 2000)
                      && (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl is string)
                      && (!('imageUrls' in request.resource.data) || request.resource.data.imageUrls is list)
                      && (!('audioUrl' in request.resource.data) || request.resource.data.audioUrl is string)
                      && (!('isDeletedForEveryone' in request.resource.data) || request.resource.data.isDeletedForEveryone is bool)
                      && (!('isEdited' in request.resource.data) || request.resource.data.isEdited is bool)
                      && (!('replyToId' in request.resource.data) || (
                           request.resource.data.replyToId is string
                           && request.resource.data.replyToText is string
                           && request.resource.data.replyToSenderId is string
                         ));
                      
        allow update: if isAuthorizedUser() && (
          // Case 1: Recipient marks as seen or delivered
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'seenAt', 'delivered', 'deliveredAt'])
            && resource.data.senderId != request.auth.uid
            && (!('seen' in request.resource.data.diff(resource.data).affectedKeys()) || (request.resource.data.seen == true && request.resource.data.seenAt == request.time))
            && (!('delivered' in request.resource.data.diff(resource.data).affectedKeys()) || (request.resource.data.delivered == true && request.resource.data.deliveredAt == request.time))
          ) ||
          // Case 2: Sender edits text (within 10 minutes)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'editedAt'])
            && resource.data.senderId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
            && request.resource.data.isEdited == true
            && request.resource.data.editedAt == request.time
            && request.time.toMillis() <= resource.data.createdAt.toMillis() + (10 * 60 * 1000)
          ) ||
          // Case 3: Any user pins/unpins
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned'])
            && request.resource.data.isPinned is bool
          ) ||
          // Case 4: Any user deletes for themselves
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
            && request.resource.data.deletedFor is list
            && (
                 (!('deletedFor' in resource.data) && request.resource.data.deletedFor == [request.auth.uid])
                 ||
                 ('deletedFor' in resource.data && 
                  request.resource.data.deletedFor.hasAll(resource.data.deletedFor) && 
                  request.resource.data.deletedFor.size() == resource.data.deletedFor.size() + 1 && 
                  request.resource.data.deletedFor[resource.data.deletedFor.size()] == request.auth.uid)
               )
          ) ||
          // Case 5: Sender soft-deletes for everyone
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeletedForEveryone'])
            && resource.data.senderId == request.auth.uid
            && request.resource.data.isDeletedForEveryone == true
          ) ||
          // Case 6: User adds or removes their own reaction (any emoji allowed)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.reactions is map
            && (
                 ! (request.auth.uid in request.resource.data.reactions) 
                 || (request.resource.data.reactions[request.auth.uid] is string && request.resource.data.reactions[request.auth.uid].size() <= 10)
               )
            && (
                 (!('reactions' in resource.data) && request.resource.data.reactions.keys().hasOnly([request.auth.uid]))
                 ||
                 ('reactions' in resource.data && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid]))
               )
          )
        );
        
        allow delete: if false;
      }
    }
    
    match /users/{userId} {
      allow read: if isAuthorizedUser();
      allow write: if isAuthorizedUser() && request.auth.uid == userId;
    }
    match /users/{userId}/private/{docId} {
      allow read, write: if request.auth.uid == userId;
    }

    match /pinSessions/{sessionId} {
      allow read, write: if isAuthorizedUser();
    }
  }
}
